<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.analyticsplatform</groupId>
    <artifactId>analytics-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>platform-common</artifactId>
  <name>Platform :: Common</name>
  <description>
    Run context, control-plane DAO, canonical schema registry, trip key,
    stream version, and the retry-aware Spark metrics listener.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-core_${scala.binary.version}</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_${scala.binary.version}</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Fixtures and test helpers here are reused by every other module's
           component tests, so they ship as a test-jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals><goal>test-jar</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- §19: mutation testing targets the pure correctness logic. A surviving
           mutant in these classes is a test-suite defect, not a curiosity. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <configuration>
          <targetClasses>
            <param>com.analyticsplatform.common.schema.*</param>
            <param>com.analyticsplatform.common.key.*</param>
            <param>com.analyticsplatform.common.stream.*</param>
            <param>com.analyticsplatform.common.unit.*</param>
          </targetClasses>
          <targetTests>
            <param>com.analyticsplatform.common.*</param>
          </targetTests>
          <mutationThreshold>85</mutationThreshold>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>gates</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check-critical-packages</id>
                <phase>verify</phase>
                <goals><goal>check</goal></goals>
                <configuration>
                  <rules>
                    <!-- Critical correctness packages carry a stricter branch
                         gate (90%) than the 80% project-wide floor. -->
                    <rule>
                      <element>PACKAGE</element>
                      <includes>
                        <include>com.analyticsplatform.common.schema</include>
                        <include>com.analyticsplatform.common.key</include>
                        <include>com.analyticsplatform.common.stream</include>
                        <include>com.analyticsplatform.common.unit</include>
                      </includes>
                      <limits>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.90</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
