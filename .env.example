# Template for the local .env. Copy and fill, or generate one with:
#
#     ./scripts/init-secrets.sh
#
# The real .env is gitignored and must never be committed. This file is the only
# credential-shaped thing in version control, and it contains no real values.
#
# Passwords are generated as 32 alphanumeric characters. Alphanumeric on purpose:
# JDBC URLs and ClickHouse DSNs both require escaping for punctuation, and an
# unescaped '@' or '/' produces a connection error that reads like a network
# fault rather than a quoting bug.

# ---- Postgres (control plane) ----------------------------------------------
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_INIT_SECRETS

# ---- ClickHouse (analytical marts) -----------------------------------------
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=platform
CLICKHOUSE_PASSWORD=CHANGE_ME_GENERATE_WITH_INIT_SECRETS
